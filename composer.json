{
  "name": "maispace/mai-seeder",
  "type": "typo3-cms-extension",
  "description": "Laravel-inspired, versioned content migrations for TYPO3 - seed and clean up records and their relations across environments.",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.5",
    "maispace/mai-base": "^14.0",
    "typo3/cms-backend": "^13.4 || ^14.0",
    "typo3/cms-core": "^13.4 || ^14.0",
    "typo3/cms-extbase": "^13.4 || ^14.0",
    "typo3/cms-fluid": "^13.4 || ^14.0"
  },
  "require-dev": {
    "armin/editorconfig-cli": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.0",
    "helmich/typo3-typoscript-lint": "^3.1",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.0",
    "saschaegerer/phpstan-typo3": "^3.0",
    "typo3/testing-framework": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "Maispace\\MaiSeeder\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Maispace\\MaiSeeder\\Tests\\": "Tests/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "mai_seeder"
    },
    "branch-alias": {
      "dev-main": "14.0.x-dev"
    }
  },
  "scripts": {
    "lint:check": [
      "@check:editorconfig",
      "@check:phpcs",
      "@check:phpstan",
      "@check:typoscript",
      "@composer validate --strict --no-check-version --no-check-all --no-check-publish"
    ],
    "lint:fix": [
      "@fix:editorconfig",
      "@fix:phpcs",
      "@check:phpstan",
      "@check:typoscript"
    ],
    "check:editorconfig": "ec -unv -e vendor/ -e public/ -e var/",
    "fix:editorconfig": "ec -unvf -e vendor/ -e public/ -e var/",
    "check:phpcs": "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer check --config .php-cs-fixer.php --ansi --verbose --diff",
    "fix:phpcs": "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix --config .php-cs-fixer.php --ansi",
    "check:phpstan": "phpstan analyse --no-progress --memory-limit=1G",
    "check:phpstan:baseline": "phpstan analyse --no-progress --memory-limit=1G --generate-baseline=phpstan-baseline.neon",
    "check:typoscript": "php -r \"if (is_dir('Configuration/TypoScript')) { passthru('typoscript-lint --fail-on-warnings -c typoscript-lint.yml Configuration/TypoScript/'); }\"",
    "test": "phpunit --configuration phpunit.xml.dist",
    "test:unit": "phpunit --configuration phpunit.xml.dist --testsuite Unit"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    },
    "platform": {
      "php": "8.5.0"
    },
    "platform-check": false
  },
  "repositories": [
    {
      "type": "path",
      "url": "../typo3-extension-base"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true
}
